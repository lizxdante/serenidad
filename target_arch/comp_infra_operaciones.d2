# =============================================================
# CLOUDFLARE EDGE
# =============================================================
cloudflare: "Cloudflare Edge — 0 USD/mes" {
  style.fill: "#FFF3E0"
  style.stroke: "#F38020"
  style.stroke-width: 2

  direction: right

  cf_pages: |md
    **Cloudflare Pages**
    Qwik v2.0 SPA + Astro v6.x
    TypeScript 6.0
    Build: git push (CI/CD)
    Deploy: automático
    500 builds/mes gratis
  | {
    style.fill: "#FFF3E0"
    style.stroke: "#F38020"
  }

  cf_workers: |md
    **Cloudflare Workers**
    Hono v4.x BFF
    TypeScript 6.0
    JWT verify Ed25519
    Edge routing
    100K req/día gratis
  | {
    style.fill: "#FFF3E0"
    style.stroke: "#F38020"
  }

  cf_pages -> cf_workers: "fetch() al BFF"
}

# =============================================================
# GITHUB — CI/CD + GitOps Source
# =============================================================
github: "GitHub — serenamente/serenidad-platform" {
  style.fill: "#F5F5F5"
  style.stroke: "#333333"

  gh_actions: |md
    **GitHub Actions CI**
    go test + go build
    docker build → ghcr.io
    Update image.tag en values.yaml
    Seal nuevos secrets

    **ghcr.io** (Container Registry)
    OCI images firmadas
  | {
    style.fill: "#F5F5F5"
    style.stroke: "#555555"
  }
}

# =============================================================
# HETZNER CX32 — TALOS LINUX + KUBERNETES
# =============================================================
hetzner: "Hetzner CX32 — ~6.80 EUR/mes | 4 vCPU AMD | 8 GB RAM | 80 GB SSD | Talos Linux v1.10.x" {
  style.fill: "#F8F9FA"
  style.stroke: "#455A64"
  style.stroke-width: 2

  direction: down

  # --- Talos Control Plane ---
  talos_cp: |md
    **Talos OS + Kubernetes 1.33.x**
    Control Plane (allowSchedulingOnControlPlanes: true)
    etcd 3.5.20 · containerd 2.0.5
    Hetzner CCM (Load Balancer + node lifecycle)
    Single-node; add CX32 workers en Fase 4+
  | {
    style.fill: "#FFF3E0"
    style.stroke: "#FF5F00"
    style.stroke-width: 2
  }

  # --- Namespace: flux-system ---
  ns_flux: "Namespace: flux-system" {
    style.fill: "#E8EAF6"
    style.stroke: "#326CE5"
    style.stroke-dash: 4

    fluxcd: |md
      **FluxCD v2.x**
      CNCF Graduated · GitOps Controller
      GitRepository → github.com/serenamente
      HelmRelease → reconcilia cada 1m
      Kustomization por namespace
      Zero drift garantizado
    | {
      style.fill: "#E8EAF6"
      style.stroke: "#326CE5"
    }
  }

  # --- Namespace: traefik ---
  ns_traefik: "Namespace: traefik" {
    style.fill: "#E0F2F1"
    style.stroke: "#00695C"
    style.stroke-dash: 4

    traefik: |md
      **Traefik v3.x**
      Ingress Controller (DaemonSet)
      hostPort 80 / 443
      ForwardAuth Middleware → IAM
      IngressRoute CRDs
      TLS via cert-manager
      Dashboard interno
    | {
      style.fill: "#E0F2F1"
      style.stroke: "#00695C"
    }
  }

  # --- Namespace: cert-manager ---
  ns_cert: "Namespace: cert-manager" {
    style.fill: "#E0F2F1"
    style.stroke: "#00695C"
    style.stroke-dash: 4

    cert_mgr: |md
      **cert-manager v1.x**
      CNCF Graduated
      ClusterIssuer Let's Encrypt
      Auto-renew certificados TLS
      Certificate CRDs
    | {
      style.fill: "#E0F2F1"
      style.stroke: "#00695C"
    }
  }

  # --- Namespace: sealed-secrets ---
  ns_secrets: "Namespace: sealed-secrets" {
    style.fill: "#E0F2F1"
    style.stroke: "#00695C"
    style.stroke-dash: 4

    sealed_sec: |md
      **Sealed Secrets v0.27+**
      Bitnami / Helm
      SealedSecret → Secret
      Clave pública en Git (seguro)
      Clave privada solo en cluster
    | {
      style.fill: "#E0F2F1"
      style.stroke: "#00695C"
    }
  }

  # --- Namespace: serenamente-core ---
  ns_core: "Namespace: serenamente-core" {
    style.fill: "#F3E5F5"
    style.stroke: "#6A1B9A"
    style.stroke-dash: 4
    grid-columns: 3

    iam_svc: |md
      **IAM Domain Service**
      Go 1.25.x + Chi v5 + pgx v5
      JWT Ed25519 enrichment
      Outbox Worker
      /internal/validate-token
      golang-migrate (init container)
    | {
      style.fill: "#FF5722"
      style.font-color: white
    }

    sched_svc: |md
      **Scheduling Service**
      Go 1.25.x + Chi v5
      FHIR R4 Appointment
      EXCLUDE USING GIST
      Outbox Worker
    | {
      style.fill: "#2196F3"
      style.font-color: white
    }

    clin_svc: |md
      **Clinical Record Service**
      Go 1.25.x + Chi v5
      Event Store append-only
      openEHR Canonical JSON
      RLS enforced
    | {
      style.fill: "#2196F3"
      style.font-color: white
    }

    bill_svc: |md
      **Billing & Ops Service**
      Go 1.25.x + Chi v5
      Multi-gateway
      Izipay · Stripe · Conekta
      Outbox Worker
    | {
      style.fill: "#9C27B0"
      style.font-color: white
    }

    kratos: |md
      **Ory Kratos v1.3.1**
      Helm: ory/kratos
      AuthN: Passkeys WebAuthn
      Self-service flows
      SAML + OIDC
    | {
      style.fill: "#5528FF"
      style.font-color: white
    }

    openfga: |md
      **OpenFGA v1.x**
      Helm: openfga/openfga
      AuthZ: Zanzibar engine
      DSL v1.1 models
      Apache 2.0
    | {
      style.fill: "#FF6B35"
      style.font-color: white
    }
  }

  # --- Namespace: serenamente-data ---
  ns_data: "Namespace: serenamente-data" {
    style.fill: "#E3F2FD"
    style.stroke: "#1565C0"
    style.stroke-dash: 4

    direction: right

    pg: |md
      **CloudNativePG v1.x**
      Operador CNCF (cnpg-system)
      Cluster CRD — PostgreSQL 17.4
      6 databases aisladas:
      iam\_db · scheduling\_db
      clinical\_db · billing\_db
      kratos\_db · openfga\_db
      WAL continuo → B2
      PITR disponible
    | {
      style.fill: "#E3F2FD"
      style.stroke: "#1565C0"
      style.stroke-width: 2
    }

    nats: |md
      **NATS JetStream v2.11.x**
      Helm: nats/nats · nats.go v1.50.0
      JetStream: storage=file (PVC)
      4 streams permanentes:
      IAM: 365d · SCHED: 730d
      CLINICAL: sin límite · BILLING: 3650d
      Consumer: explicit ACK · MaxDeliver: 5
    | {
      style.fill: "#27AE60"
      style.font-color: white
    }
  }

  # --- Namespace: serenamente-ops (Fase 3) ---
  ns_ops: "Namespace: serenamente-ops — Fase 3" {
    style.fill: "#ECEFF1"
    style.stroke: "#607D8B"
    style.stroke-dash: 4

    obs: |md
      **kube-prometheus-stack v82.x**
      Prometheus v3.x :9090
      Grafana v11.x :3000
      Alertmanager v0.27+ :9093
      Loki v3.x + Promtail
      Tempo v2.9+
      ServiceMonitor auto-discovery
      Alertas → Telegram bot
    | {
      style.fill: "#ECEFF1"
      style.stroke: "#607D8B"
    }
  }
}

# =============================================================
# BACKUPS EXTERNOS — Backblaze B2
# =============================================================
backups: "Backups — Backblaze B2 — ~0.05 USD/mes" {
  style.fill: "#E8F5E9"
  style.stroke: "#4CAF50"

  b2: |md
    **CloudNativePG barman-cloud**
    WAL archiving continuo
    ScheduledBackup CRD (02:00 UTC)
    Retention: 30 días base backup
    WAL: 90 días (B2 lifecycle rule)
    PITR a cualquier punto
    Restore: kubectl cnpg restore
  | {
    style.fill: "#E8F5E9"
    style.stroke: "#4CAF50"
  }
}

# =============================================================
# CONEXIONES
# =============================================================

# Usuario → Cloudflare
browser -> cloudflare.cf_pages: "HTTPS app.serenamente.com\n(Qwik v2.0 resumable)"

# CF → Hetzner Ingress
cloudflare.cf_workers -> hetzner.ns_traefik.traefik: "HTTPS api.serenamente.com :443 TLS 1.3"

# cert-manager → Traefik
hetzner.ns_cert.cert_mgr -> hetzner.ns_traefik.traefik: "Certificate TLS\nLet's Encrypt auto" {
  style.stroke-dash: 5
}

# Traefik → Servicios
hetzner.ns_traefik.traefik -> hetzner.ns_core.iam_svc: "ForwardAuth Middleware\n→ /internal/validate-token\ncopy_headers X-User-ID X-User-Role X-Tenant-ID"
hetzner.ns_traefik.traefik -> hetzner.ns_core.sched_svc: "/api/scheduling/*"
hetzner.ns_traefik.traefik -> hetzner.ns_core.clin_svc: "/api/clinical/*"
hetzner.ns_traefik.traefik -> hetzner.ns_core.bill_svc: "/api/billing/*"
hetzner.ns_traefik.traefik -> hetzner.ns_core.kratos: "/auth/* (public:4433)"

# IAM internals
hetzner.ns_core.iam_svc -> hetzner.ns_core.kratos: "Kratos Admin API :4434\nSession verification"
hetzner.ns_core.iam_svc -> hetzner.ns_core.openfga: "OpenFGA HTTP :8080\nCheck + WriteTuples"

# Servicios → PostgreSQL (via CloudNativePG Service)
hetzner.ns_core.iam_svc -> hetzner.ns_data.pg: "iam_db · kratos_db · openfga_db\npgx/v5 pgxpool"
hetzner.ns_core.sched_svc -> hetzner.ns_data.pg: "scheduling_db\npgx/v5 pgxpool"
hetzner.ns_core.clin_svc -> hetzner.ns_data.pg: "clinical_db\npgx/v5 pgxpool"
hetzner.ns_core.bill_svc -> hetzner.ns_data.pg: "billing_db\npgx/v5 pgxpool"

# Servicios → NATS (Outbox Worker, asíncronos)
hetzner.ns_core.iam_svc -> hetzner.ns_data.nats: "Proto3: DoctorOnboarded" {
  style.stroke-dash: 5
  style.stroke: "#27AE60"
}
hetzner.ns_core.sched_svc -> hetzner.ns_data.nats: "Proto3: AppointmentBooked" {
  style.stroke-dash: 5
  style.stroke: "#27AE60"
}
hetzner.ns_core.clin_svc -> hetzner.ns_data.nats: "Proto3: DiagnosisRecorded" {
  style.stroke-dash: 5
  style.stroke: "#27AE60"
}
hetzner.ns_core.bill_svc -> hetzner.ns_data.nats: "Proto3: PaymentCaptured" {
  style.stroke-dash: 5
  style.stroke: "#27AE60"
}

# NATS → Consumidores (JetStream durable, asíncronos)
hetzner.ns_data.nats -> hetzner.ns_core.clin_svc: "JetStream durable\nAppointmentBooked" {
  style.stroke-dash: 5
  style.stroke: "#27AE60"
}
hetzner.ns_data.nats -> hetzner.ns_core.bill_svc: "JetStream durable\nConsultationFinished" {
  style.stroke-dash: 5
  style.stroke: "#27AE60"
}
hetzner.ns_data.nats -> hetzner.ns_core.sched_svc: "JetStream durable\nDoctorOffboarded" {
  style.stroke-dash: 5
  style.stroke: "#27AE60"
}

# Backups
hetzner.ns_data.pg -> backups.b2: "WAL continuo + daily backup\nbarman-cloud → B2"

